{
    // AI features
    "chat.disableAIFeatures": true,
    "workbench.settings.showAISearchToggle": false,
    "workbench.settings.enableNaturalLanguageSearch": false,

    // Annoyances
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "extensions.ignoreRecommendations": true,

    // Telemetry & diagnostics
    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": false,
    "telemetry.editStats.enabled": false,
    "telemetry.editStats.showStatusBar": false,
    "telemetry.editStats.details.enabled": false,
    "telemetry.editStats.showDecorations": false,
    "editor.experimental.treeSitterTelemetry": false,

    // GUI
    "workbench.startupEditor": "none",
    "workbench.colorTheme": "Light Modern",
    "workbench.iconTheme": "vscode-modern-icons",
    "workbench.editor.enablePreview": false,
    "workbench.layoutControl.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "workbench.navigationControl.enabled": false,

    // Editor
    "editor.fontSize": 13,
    "editor.rulers": [
        120
    ],
    "editor.minimap.enabled": false,
    "editor.minimap.renderCharacters": false,

    // Terminal
    "terminal.explorerKind": "external",
    "terminal.external.osxExec": "Terminal.app",

    // File and code formatting
    "files.autoSave": "onFocusChange",
    "editor.formatOnSave": true,
    "json.format.keepLines": true,
    "files.trimFinalNewlines": true,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.bracketPairColorization.enabled": true,

    // VsCodeVim
    "vim.useSystemClipboard": true,
    "vim.gdefault": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.ignorecase": true,
    "vim.smartcase": true,
    "editor.lineNumbers": "relative",
    "vim.leader": "<space>",
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [ "<leader>", "o" ],
            "after": [ "o", "<Esc>", "o" ]
        },
        {
            "before": [ "<leader>", "O" ],
            "after": [ "O", "<Esc>", "O" ]
        }
    ],

    // .NET/C#
    "csharp.debug.console": "externalTerminal",
    "dotnet.codeLens.enableReferencesCodeLens": false
}
